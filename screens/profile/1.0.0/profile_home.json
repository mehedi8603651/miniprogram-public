            "fontWeight": "w700"
          },
          "type": "text"
        },
        {
          "height": 12.0,
          "type": "sizedBox"
        },
        {
          "data": "Start from a realistic portable profile/settings flow. Replace the copy and data shape with your business case, then add host-specific work only after the contract is real.",
          "type": "text"
        },
        {
          "height": 16.0,
          "type": "sizedBox"
        },
        {
          "padding": {
            "left": 14.0,
            "top": 12.0,
            "right": 14.0,
            "bottom": 12.0
          },
          "decoration": {
            "color": "#E0F2FE",
            "borderRadius": {
              "topLeft": 18.0,
              "topRight": 18.0,
              "bottomLeft": 18.0,
              "bottomRight": 18.0
            }
          },
          "child": {
            "data": "Starter capabilities: analytics",
            "style": {
              "type": "custom",
              "color": "#0C4A6E",
              "fontSize": 15.0,
              "fontWeight": "w600"
            },
            "type": "text"
          },
          "type": "container"
        },
        {
          "height": 20.0,
          "type": "sizedBox"
        },
        {
          "padding": {
            "left": 18.0,
